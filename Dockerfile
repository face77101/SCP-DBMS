# =========================================================================
# 第一步：挑選基底 (Base Image)
# =========================================================================
# 這行意思是：「請去雲端幫我抓一台已經裝好 Python 3.10 的乾淨 Linux 微型電腦過來」。
# 後面的 "-slim" 代表瘦身版，把不必要的雜七雜八軟體都拔掉，這樣你的貨櫃體積會很小、啟動很快。
FROM python:3.10-slim

# =========================================================================
# 第二步：指定辦公室 (Working Directory)
# =========================================================================
# 告訴系統：「進到這台微型電腦後，幫我建立一個叫做 /app 的資料夾，並且之後所有的動作都在這裡面進行。」
# (這剛好對應到 docker-compose 裡的 volumes: ./backend:/app)
WORKDIR /app

# =========================================================================
# 第三步：裝備採購清單 (Copy Requirements)
# =========================================================================
# 由於後端是用 Python 寫的，會需要用到別人寫好的套件 (如 Flask, pymysql, bcrypt 等)。
# 這裡把本機 backend 資料夾裡的 requirements.txt，複製進微型電腦的 /app 裡面。
COPY backend/requirements.txt .

# =========================================================================
# 第四步：安裝套件 (Install Dependencies)
# =========================================================================
# 告訴微型電腦：「打開終端機，執行 pip install 來安裝清單上的所有套件」。
# --no-cache-dir 是為了不留下安裝檔的垃圾，讓這台微型電腦保持輕盈。
RUN pip install --no-cache-dir -r requirements.txt

# =========================================================================
# 第五步：搬入程式碼 (Copy Source Code)
# =========================================================================
# 雖然 docker-compose 有用 volumes 自動綁定資料夾，
# 但為了讓這個 Dockerfile 可以獨立運作（例如未來要丟到真正的雲端伺服器上），
# 我們還是會把 backend 資料夾裡的所有程式碼，完整複製進去微型電腦的 /app 裡面。
COPY backend/ .
COPY frontend/ /frontend/

# =========================================================================
# 第六步：宣告營業通道 (Expose Port)
# =========================================================================
# 這只是一個「標示」，告訴其他工程師或系統：「這隻後端程式預設會從 5000 號門進出喔」。
EXPOSE 5000

# =========================================================================
# 第七步：啟動主程式 (Command)
# =========================================================================
# 當這個貨櫃啟動的最後一刻，自動幫我在終端機打上 `python app.py` (或是你的主程式名稱)。
# 這樣 API 伺服器就會正式醒來，開始監聽來自網頁的登入請求！
CMD ["python", "app.py"]